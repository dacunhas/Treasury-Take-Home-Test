# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Gemini Flash — fast primary extractor (vision). Required for live extraction.
GEMINI_API_KEY=

# Anthropic Claude Sonnet — conditional deep tier (vision). Required for escalation.
ANTHROPIC_API_KEY=

# Optional: confidence threshold (0-1) below which Flash escalates to Sonnet.
# Defaults to 0.7 if unset.
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# Optional: override the Flash model id (e.g. if a model is retired).
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: Flash call timeout in ms (abort budget). Defaults to 9000.
# GEMINI_TIMEOUT_MS=9000
# Optional: Gemini reasoning level (low|medium|high). Defaults to low for latency.
# GEMINI_THINKING_LEVEL=low
