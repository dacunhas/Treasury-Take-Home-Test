# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Gemini Flash — fast primary extractor (vision). Required for live extraction.
GEMINI_API_KEY=

# Anthropic Claude Sonnet — conditional deep tier (vision). Required for escalation.
ANTHROPIC_API_KEY=

# Optional: confidence threshold (0-1) below which Flash escalates to Sonnet.
# Defaults to 0.7 if unset.
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
